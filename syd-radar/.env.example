# Untappd check-in Worker (public, no credentials). The bare URL streams the default venue's check-ins
# (?venue=<id> picks another venue); add ?feed=friends to stream the owner's friends' check-ins instead.
VITE_UNTAPPD_WS_URL=wss://untappd-venue-fetcher.ishmagel.workers.dev/?feed=friends
# Flight data Worker (syd-radar/worker). No token is ever needed in the browser.
VITE_FLIGHTS_API_URL=https://syd-radar-flights.ishmagel.workers.dev
# Optional: OpenSky Network credentials for the historical hook (free account)
# VITE_OPENSKY_USER=
# VITE_OPENSKY_PASS=
